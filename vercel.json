{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "ia.html",
      "use": "@vercel/static"
    },
    {
      "src": "captacao/index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/captacao",
      "dest": "/captacao/index.html"
    },
    {
      "src": "/ia",
      "dest": "/ia.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
